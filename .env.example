# Run Ollama separately. No model is downloaded automatically.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_SECONDS=45
# Short structured plans; increase only if replies are repeatedly cut short.
OLLAMA_NUM_PREDICT=512
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=30
MAX_TABLES=30
MAX_DATASET_ROWS=20000
EXTRACTION_TIMEOUT_SECONDS=25
EXTRACTION_MEMORY_MB=1536
# Used to resolve calendar-relative questions; independent of dataset dates.
APP_TIMEZONE=Asia/Kolkata
